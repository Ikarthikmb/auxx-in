# Copy to .env (chmod 600). Only the first block is needed: everything else can
# be set on the page (Settings -> Configuration), which overrides this file.
# Keep comments on their own lines: Docker reads "KEY=   # note" as the value "# note".

# --- containers (restart to change)
# Where songs are saved and played from. Not set = the music/ folder here.
# With Navidrome, set it to the folder Navidrome scans. Must be owned by PUID:PGID.
# MUSIC_DIR=/path/to/music
# Queue, settings, covers. Must be owned by PUID:PGID.
AUX_DATA=./data
# Address the ports listen on (127.0.0.1, 0.0.0.0, a LAN or VPN IP)
AUX_BIND=127.0.0.1
# The Auxx In page, and the radio stream
AUX_WEB_PORT=8140
AUX_RADIO_PORT=8141
# Your user and group (run: id -u; id -g), the owner of the music and data folders
PUID=1000
PGID=1000
TZ=UTC
# Radio -> web key; made on first run if not set
# INTERNAL_KEY=

# --- defaults for Settings -> Configuration (optional; the page overrides them)
USE_NAVIDROME=true
# e.g. http://navidrome:4533 as the container reaches it; not set = run without Navidrome
# NAVIDROME_URL=
# NAVIDROME_USER=
# NAVIDROME_PASS=
# What players tune in to, e.g. http://your-server:8141/aux.mp3
# STREAM_URL=
REQUESTS_PLAYLIST=Requests
PLAYLIST_CAP=50
AUTOPLAY_DAILY=40
# 0 = best VBR, or 320K / 192K / 128K
MP3_QUALITY=0
# Skip songs bigger than this many MB (0 = no limit)
MAX_SONG_MB=100
# Stop downloading when the music disk has less than this many GB free (0 = off)
KEEP_FREE_GB=5
# Aux IQ: any OpenAI-compatible chat endpoint
# LLM_URL=
# LLM_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BACKUP=gemini-3.5-flash-lite
IQ_BUFFER=5
IQ_DAILY=20

# --- login (optional)
# When served over HTTPS:
# COOKIE_SECURE=true
# First admin without the setup code (used once, when there are no users; remove afterwards):
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Trust a login proxy (Authelia, Authentik, Tinyauth...) and its admins:
# AUTH_PROXY_HEADER=Remote-User
# AUTH_PROXY_ADMINS=alice,bob
# Shares per user, and YouTube searches / previews per user:
# LIMIT_ADD=60 per hour
# LIMIT_SEARCH=60 per minute
